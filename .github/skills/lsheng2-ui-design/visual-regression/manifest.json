      "source": "`ui_web/views/bug_trend_view.py`, `ui_web/templates/bug_trend_scope_config.html`, `ui_web/facades/bug_trend_facade.py`, `ui_web/facades/provider_scope_setup.py`, `ui_web/static/css/main.css`, `ui_web/static/js/main.js`",
      "validationCommand": "`.venv\\Scripts\\python.exe manage.py test ui_web.tests.test_bug_trend_scope_config_views ui_web.tests.test_dashboard_ui_design_system`",
      "notes": "Scope editor, provider binding, metadata refresh, action-specific required validation, dirty/cancel state.",
      "stateTargets": [
        "default",
        "required-missing",
        "dirty-unsaved",
        "save-success",
        "save-error",
        "chart-default",
        "chart-empty",
        "chart-loading",
        "chart-drilldown-selected"
