{
  "schemaVersion": 1,
  "owner": "lsheng2-ui-design",
  "purpose": "Local visual regression capture plan. It is a manifest for Playwright, browser tests, or manual capture tools; it does not upload artifacts.",
  "viewports": [
    {
      "name": "desktop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "tablet",
      "width": 768,
      "height": 1024
    },
    {
      "name": "phone",
      "width": 390,
      "height": 900
    }
  ],
  "defaultChecks": [
    "no-page-horizontal-overflow",
    "no-clipped-action-buttons",
    "consistent-control-height",
    "visible-focus-state",
    "required-dirty-error-loading-success-states-when-applicable",
    "text-fits-in-buttons-labels-cards-table-cells"
  ],
  "componentStateTargets": [
    "button/default-hover-focus-disabled-loading-danger",
    "form/default-required-missing-dirty-saving-success-failure",
    "table/default-empty-loading-selected-archived-error",
    "tabs/default-selected-hover-focus-disabled",
    "status-feedback/info-success-warning-danger"
  ],
  "capturePlan": [
    {
      "name": "provider-setup",
      "url": "http://127.0.0.1:8000/provider-setup/",
      "route": "/provider-setup/",
      "priority": "high",
      "source": "`ui_web/views/bug_trend_view.py`, `ui_web/templates/provider_setup.html`, `ui_web/templates/provider_profile_config.html`, `ui_web/templates/partials/provider_profile_editor.html`, `ui_web/facades/bug_trend_facade.py`, `ui_web/facades/provider_scope_setup.py`, `ui_web/static/css/main.css`, `ui_web/static/js/main.js`",
      "validationCommand": "`.venv\\Scripts\\python.exe manage.py test ui_web.tests.test_provider_setup_views ui_web.tests.test_dashboard_ui_design_system`",
      "notes": "Provider profile inventory, create/edit/test/import/export/archive/delete, provider color tabs, connection/auth/probe fields.",
      "stateTargets": [
        "default",
        "required-missing",
        "dirty-unsaved",
        "save-success",
        "save-error",
        "action-success",
        "action-error",
        "disabled-or-confirmation",
        "empty",
        "loading",
        "table-density"
      ]
    },
    {
      "name": "bug-trend-scope-config",
      "url": "http://127.0.0.1:8000/bug-trend/scope-config/",
      "route": "/bug-trend/scope-config/",
