{
  "$description": "Meridian light theme. References point at Radix Colors light ramps generated by build-tokens.mjs ({ramp.<scale>.<step>}).",
  "color": {
    "$type": "color",
    "canvas": { "$value": "{ramp.slate.2}", "$description": "App background behind cards, sidebar and topbar" },
    "surface": { "$value": "#ffffff", "$description": "Cards, panels, tables" },
    "surface-raised": { "$value": "#ffffff", "$description": "Popovers, dialogs, dropdowns, toasts" },
    "surface-muted": { "$value": "{ramp.slate.2}", "$description": "Table headers, secondary fills, wells" },
    "surface-hover": { "$value": "{ramp.slate.3}" },
    "surface-active": { "$value": "{ramp.slate.4}" },
    "surface-inverse": { "$value": "{ramp.slate.12}", "$description": "Ink primary buttons, tooltips" },
    "on-inverse": { "$value": "#ffffff" },
    "border": { "$value": "{ramp.slate.5}", "$description": "Card and panel outlines" },
    "border-subtle": { "$value": "{ramp.slate.4}", "$description": "Row dividers, inner separators" },
    "border-strong": { "$value": "{ramp.slate.7}", "$description": "Hovered outlines, emphasized dividers" },
    "border-input": { "$value": "{ramp.slate.9}", "$description": "Bottom stroke of text controls; keeps 3:1 on surfaces (WCAG 1.4.11)" },
    "text": { "$value": "{ramp.slate.12}" },
    "text-secondary": { "$value": "{ramp.slate.11}" },
    "text-tertiary": { "$value": "#696c75", "$description": "Low-emphasis meta text (labels, timestamps, crumbs); between slate 10 and 11 so small text keeps >= 4.5:1 on canvas, surface, muted and hover fills" },
    "text-disabled": { "$value": "{ramp.slate.8}" },
    "accent": { "$value": "{ramp.indigo.9}" },
    "accent-hover": { "$value": "{ramp.indigo.10}" },
    "accent-text": { "$value": "{ramp.indigo.11}", "$description": "Links, active nav text, accent labels" },
    "accent-subtle": { "$value": "{ramp.indigo.3}" },
    "accent-subtle-hover": { "$value": "{ramp.indigo.4}" },
    "accent-border": { "$value": "{ramp.indigo.7}" },
    "on-accent": { "$value": "#ffffff" },
    "focus-ring": { "$value": "{ramp.indigo.9}" },
    "focus-halo": { "$value": "{ramp.indigo.5}", "$description": "Soft 3px halo around focused inputs" },
    "selection": { "$value": "{ramp.indigo.5}" },
    "success": { "$value": "{ramp.grass.9}" },
    "success-text": { "$value": "{ramp.grass.11}" },
    "success-subtle": { "$value": "{ramp.grass.3}" },
    "success-subtle-hover": { "$value": "{ramp.grass.4}" },
    "success-border": { "$value": "{ramp.grass.7}" },
    "on-success": { "$value": "#ffffff", "$description": "Glyph on a solid success fill (icons only, 3:1). Text uses success-text on success-subtle." },
    "warning": { "$value": "{ramp.amber.9}" },
    "warning-text": { "$value": "#966400", "$description": "Tuned darker than amber 11 for AA on warning-subtle" },
    "warning-subtle": { "$value": "{ramp.amber.3}" },
    "warning-subtle-hover": { "$value": "{ramp.amber.4}" },
    "warning-border": { "$value": "{ramp.amber.7}" },
    "on-warning": { "$value": "{ramp.amber.12}" },
    "danger": { "$value": "{ramp.red.9}" },
    "danger-text": { "$value": "{ramp.red.11}" },
    "danger-subtle": { "$value": "{ramp.red.3}" },
    "danger-subtle-hover": { "$value": "{ramp.red.4}" },
    "danger-border": { "$value": "{ramp.red.7}" },
    "on-danger": { "$value": "#ffffff", "$description": "Glyph on a solid danger fill (icons only, 3:1)" },
    "info": { "$value": "{ramp.blue.9}" },
    "info-text": { "$value": "#0969da", "$description": "Tuned darker than blue 11 for AA on info-subtle" },
    "info-subtle": { "$value": "{ramp.blue.3}" },
    "info-subtle-hover": { "$value": "{ramp.blue.4}" },
    "info-border": { "$value": "{ramp.blue.7}" },
    "on-info": { "$value": "#ffffff", "$description": "Glyph on a solid info fill (icons only, 3:1)" },
    "neutral-subtle": { "$value": "{ramp.slate.3}" },
    "neutral-subtle-hover": { "$value": "{ramp.slate.4}" },
    "neutral-text": { "$value": "{ramp.slate.11}" },
    "neutral-border": { "$value": "{ramp.slate.6}" },
    "scrollbar": { "$value": "{ramp.slate.7}" },
    "scrollbar-hover": { "$value": "{ramp.slate.8}" },
    "skeleton": { "$value": "{ramp.slate.3}" },
    "scrim": { "$value": "{ramp.blackA.6}" },
    "chart": {
      "1": { "$value": "{ramp.indigo.9}" },
      "2": { "$value": "{ramp.teal.9}" },
      "3": { "$value": "{ramp.orange.10}", "$description": "Orange 9 is 2.97:1 on white; step 10 keeps the 3:1 graphics minimum" },
      "4": { "$value": "{ramp.crimson.9}" },
      "5": { "$value": "{ramp.cyan.9}" },
      "6": { "$value": "{ramp.grass.9}" },
      "7": { "$value": "{ramp.violet.9}" },
      "8": { "$value": "{ramp.amber.11}" }
    },
    "series": {
      "$description": "Bug trend series (bug_metrics BugTrendSeriesDefinition names, kebab-cased).",
      "all-open-bugs": { "$value": "{ramp.indigo.9}" },
      "all-open-critical-high": { "$value": "{ramp.orange.10}" },
      "new-critical-high": { "$value": "{ramp.red.9}" },
      "new-medium-low": { "$value": "{ramp.cyan.9}" },
      "fixed-or-closed-bugs": { "$value": "{ramp.grass.9}" }
    },
    "health": {
      "$description": "Forecast health signal (sd_metrics_lib HealthStatus names, lower-cased). Dots and card stripes only; the status name is always rendered as text beside them.",
      "green": { "$value": "{ramp.grass.10}", "$description": "Grass 9 is 2.88:1 on muted fills; step 10 keeps 3:1 on striped rows" },
      "yellow": { "$value": "#b07a00", "$description": "Amber 9 is 1.6:1 on white; tuned gold keeps the 3:1 graphics minimum on surface and muted fills" },
      "orange": { "$value": "{ramp.orange.10}" },
      "red": { "$value": "{ramp.red.9}" },
      "gray": { "$value": "{ramp.slate.9}" }
    }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 1px 0 {ramp.blackA.1}" },
    "sm": { "$value": "0 1px 2px 0 {ramp.blackA.1}, 0 1px 3px 0 {ramp.blackA.1}" },
    "md": { "$value": "0 4px 12px -2px {ramp.blackA.2}, 0 2px 4px -2px {ramp.blackA.1}" },
    "lg": { "$value": "0 16px 40px -8px {ramp.blackA.3}, 0 4px 12px -4px {ramp.blackA.2}" }
  }
}
