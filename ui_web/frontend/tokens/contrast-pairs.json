    { "fg": "color-on-accent", "bg": ["color-accent", "color-accent-hover"], "min": 4.5, "level": "error" },
    { "fg": "color-on-inverse", "bg": ["color-surface-inverse"], "min": 4.5, "level": "error" },
    { "fg": "color-success-text", "bg": ["color-surface", "color-success-subtle"], "min": 4.5, "level": "error" },
    { "fg": "color-warning-text", "bg": ["color-surface", "color-warning-subtle"], "min": 4.5, "level": "error" },
    { "fg": "color-danger-text", "bg": ["color-surface", "color-danger-subtle"], "min": 4.5, "level": "error" },
    { "fg": "color-info-text", "bg": ["color-surface", "color-info-subtle"], "min": 4.5, "level": "error" },
