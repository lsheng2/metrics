  "pairs": [
    { "fg": "color-text", "bg": ["color-canvas", "color-surface", "color-surface-muted", "color-surface-raised", "color-surface-hover", "color-surface-active"], "min": 4.5, "level": "error" },
    { "fg": "color-text-secondary", "bg": ["color-canvas", "color-surface", "color-surface-muted", "color-surface-raised", "color-surface-hover"], "min": 4.5, "level": "error" },
