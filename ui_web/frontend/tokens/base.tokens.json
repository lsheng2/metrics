{
  "$description": "Theme-independent Meridian tokens. Values are authored as final CSS strings; build-tokens.mjs emits them on :root.",
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Mona Sans Variable", "Microsoft YaHei UI", "PingFang SC", "Noto Sans SC", "Segoe UI", "sans-serif"]
    },
    "mono": {
      "$value": ["Geist Mono Variable", "Cascadia Mono", "Consolas", "Microsoft YaHei UI", "monospace"]
    }
  },
  "text": {
    "$type": "dimension",
    "2xs": { "$value": "0.6875rem", "$description": "11px - micro labels, dense badges" },
    "xs": { "$value": "0.75rem", "$description": "12px - captions, table headers, help" },
    "sm": { "$value": "0.8125rem", "$description": "13px - default UI and table text" },
    "md": { "$value": "0.875rem", "$description": "14px - emphasized body, card titles" },
    "lg": { "$value": "1rem", "$description": "16px - section headings" },
    "xl": { "$value": "1.25rem", "$description": "20px - page titles" },
    "2xl": { "$value": "1.625rem", "$description": "26px - KPI values" },
    "3xl": { "$value": "2.125rem", "$description": "34px - hero KPI values" }
  },
  "weight": {
    "$type": "fontWeight",
    "regular": { "$value": "400" },
    "medium": { "$value": "500" },
    "semibold": { "$value": "600" },
    "bold": { "$value": "700" },
    "paper-regular": { "$value": "400", "$description": "Paper is fixed-light, so it keeps light weights; dark optical compensation must not thin dark-on-white text" },
    "paper-medium": { "$value": "500" },
    "paper-semibold": { "$value": "600" },
    "paper-bold": { "$value": "700" }
  },
  "leading": {
    "$type": "number",
    "none": { "$value": "1" },
    "tight": { "$value": "1.2" },
    "snug": { "$value": "1.35" },
    "normal": { "$value": "1.5" }
  },
  "tracking": {
    "$type": "dimension",
    "tight": { "$value": "-0.01em" },
    "normal": { "$value": "0" },
    "caps": { "$value": "0.06em" }
  },
  "stretch": {
    "$type": "string",
    "condensed": { "$value": "92%", "$description": "Mona Sans wdth axis for dense data tables" },
    "normal": { "$value": "100%" },
    "display": { "$value": "112%", "$description": "Mona Sans wdth axis for page titles and KPI values" }
  },
  "space": {
    "$type": "dimension",
    "px": { "$value": "1px" },
    "0-5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "2-5": { "$value": "0.625rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "3px" },
    "sm": { "$value": "4px" },
    "md": { "$value": "6px" },
    "lg": { "$value": "10px" },
    "xl": { "$value": "14px" },
    "full": { "$value": "9999px" }
  },
  "control": {
    "$type": "dimension",
    "height": { "$value": "2rem", "$description": "32px default control" },
    "height-sm": { "$value": "1.75rem", "$description": "28px small control" },
    "height-xs": { "$value": "1.5rem", "$description": "24px in-table control" },
    "label-height": { "$value": "1.375rem", "$description": "22px field label row; labels in one form row share it" },
    "padding-x": { "$value": "0.75rem" },
    "padding-x-sm": { "$value": "0.5rem" },
    "border-width": { "$value": "1px" }
  },
  "layout": {
    "$type": "dimension",
    "sidebar-width": { "$value": "15rem", "$description": "Default expanded sidebar; users can resize 168-360px" },
    "sidebar-rail": { "$value": "3.25rem" },
    "topbar-height": { "$value": "2.75rem" },
    "statusbar-height": { "$value": "1.75rem" },
    "content-max": { "$value": "112rem" },
    "gutter": { "$value": "1.25rem" }
  },
  "duration": {
    "$type": "duration",
    "fast": { "$value": "120ms" },
    "base": { "$value": "180ms" },
    "slow": { "$value": "260ms" }
  },
  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "exit": { "$value": [0.3, 0, 0.8, 0.15] }
  },
  "z": {
    "$type": "number",
    "sticky": { "$value": "10" },
    "topbar": { "$value": "30" },
    "statusbar": { "$value": "35" },
    "dropdown": { "$value": "40" },
    "overlay": { "$value": "45" },
    "drawer": { "$value": "50" },
    "toast": { "$value": "60" }
  },
  "color": {
    "$type": "color",
    "provider": {
      "$description": "Provider identity colors shared with provider setup and scope workflows in both themes.",
      "green": { "$value": "#2f9e44" },
      "blue": { "$value": "#1c7ed6" },
      "purple": { "$value": "#8b5cf6" }
    },
    "paper": {
      "$description": "Fixed-light document surface for authored report content in both themes. Mirrors the export palette so authored paint colors keep their meaning.",
      "bg": { "$value": "#ffffff" },
      "bg-muted": { "$value": "#f8fafc", "$description": "Quoted read-only notes and code inside paper" },
      "text": { "$value": "#1f2933" },
      "link": { "$value": "#0f766e" },
      "rule": { "$value": "#cbd5e1", "$description": "Table borders and blockquote rules inside paper" },
      "table-header": { "$value": "#ecfeff" },
      "accent": { "$value": "#0f766e", "$description": "Checked task boxes inside paper" },
      "control": { "$value": "#64748b", "$description": "Unchecked task box strokes inside paper; keeps 3:1 on paper (WCAG 1.4.11)" },
      "selection": { "$value": "#bfdbfe" }
    }
  }
}
