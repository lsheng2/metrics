{
  "$description": "Meridian dark theme. References point at Radix Colors dark ramps generated by build-tokens.mjs ({ramp.<scale>.<step>}).",
  "color": {
    "$type": "color",
    "canvas": { "$value": "{ramp.slate.1}", "$description": "App background behind cards, sidebar and topbar" },
    "surface": { "$value": "{ramp.slate.2}", "$description": "Cards, panels, tables" },
    "surface-raised": { "$value": "{ramp.slate.3}", "$description": "Popovers, dialogs, dropdowns, toasts" },
    "surface-muted": { "$value": "{ramp.slate.3}", "$description": "Table headers, secondary fills, wells" },
    "surface-hover": { "$value": "{ramp.slate.4}" },
    "surface-active": { "$value": "{ramp.slate.5}" },
    "surface-inverse": { "$value": "{ramp.slate.12}", "$description": "Ink primary buttons, tooltips" },
    "on-inverse": { "$value": "{ramp.slate.1}" },
    "border": { "$value": "{ramp.slate.6}", "$description": "Card and panel outlines" },
    "border-subtle": { "$value": "{ramp.slate.5}", "$description": "Row dividers, inner separators" },
    "border-strong": { "$value": "{ramp.slate.8}", "$description": "Hovered outlines, emphasized dividers" },
    "border-input": { "$value": "{ramp.slate.9}", "$description": "Bottom stroke of text controls; keeps 3:1 on surfaces (WCAG 1.4.11)" },
    "text": { "$value": "{ramp.slate.12}" },
    "text-secondary": { "$value": "{ramp.slate.11}" },
    "text-tertiary": { "$value": "#8e929a", "$description": "Low-emphasis meta text (labels, timestamps, crumbs); between slate 10 and 11 so small text keeps >= 4.5:1 on canvas, surface, muted, raised and hover fills" },
    "text-disabled": { "$value": "{ramp.slate.8}" },
    "accent": { "$value": "{ramp.indigo.9}" },
    "accent-hover": { "$value": "{ramp.indigo.8}", "$description": "Darker than accent so on-accent text keeps AA" },
    "accent-text": { "$value": "{ramp.indigo.11}", "$description": "Links, active nav text, accent labels" },
    "accent-subtle": { "$value": "{ramp.indigo.3}" },
    "accent-subtle-hover": { "$value": "{ramp.indigo.4}" },
    "accent-border": { "$value": "{ramp.indigo.7}" },
    "on-accent": { "$value": "#ffffff" },
    "focus-ring": { "$value": "{ramp.indigo.10}" },
    "focus-halo": { "$value": "{ramp.indigo.6}", "$description": "Soft 3px halo around focused inputs" },
    "selection": { "$value": "{ramp.indigo.6}" },
    "success": { "$value": "{ramp.grass.9}" },
    "success-text": { "$value": "{ramp.grass.11}" },
    "success-subtle": { "$value": "{ramp.grass.3}" },
    "success-subtle-hover": { "$value": "{ramp.grass.4}" },
    "success-border": { "$value": "{ramp.grass.7}" },
    "on-success": { "$value": "#ffffff" },
    "warning": { "$value": "{ramp.amber.9}" },
    "warning-text": { "$value": "{ramp.amber.11}" },
    "warning-subtle": { "$value": "{ramp.amber.3}" },
    "warning-subtle-hover": { "$value": "{ramp.amber.4}" },
    "warning-border": { "$value": "{ramp.amber.7}" },
    "on-warning": { "$value": "{ramp.amber.1}" },
    "danger": { "$value": "{ramp.red.9}" },
    "danger-text": { "$value": "{ramp.red.11}" },
    "danger-subtle": { "$value": "{ramp.red.3}" },
    "danger-subtle-hover": { "$value": "{ramp.red.4}" },
    "danger-border": { "$value": "{ramp.red.7}" },
    "on-danger": { "$value": "#ffffff" },
    "info": { "$value": "{ramp.blue.9}" },
    "info-text": { "$value": "{ramp.blue.11}" },
    "info-subtle": { "$value": "{ramp.blue.3}" },
    "info-subtle-hover": { "$value": "{ramp.blue.4}" },
    "info-border": { "$value": "{ramp.blue.7}" },
    "on-info": { "$value": "#ffffff" },
    "neutral-subtle": { "$value": "{ramp.slate.4}" },
    "neutral-subtle-hover": { "$value": "{ramp.slate.5}" },
    "neutral-text": { "$value": "{ramp.slate.11}" },
    "neutral-border": { "$value": "{ramp.slate.6}" },
    "scrollbar": { "$value": "{ramp.slate.7}" },
    "scrollbar-hover": { "$value": "{ramp.slate.8}" },
    "skeleton": { "$value": "{ramp.slate.4}" },
    "scrim": { "$value": "{ramp.blackA.8}" },
    "chart": {
      "1": { "$value": "{ramp.indigo.10}" },
      "2": { "$value": "{ramp.teal.10}" },
      "3": { "$value": "{ramp.orange.10}" },
      "4": { "$value": "{ramp.crimson.10}" },
      "5": { "$value": "{ramp.cyan.10}" },
      "6": { "$value": "{ramp.grass.10}" },
      "7": { "$value": "{ramp.violet.10}" },
      "8": { "$value": "{ramp.amber.9}" }
    },
    "series": {
      "$description": "Bug trend series (bug_metrics BugTrendSeriesDefinition names, kebab-cased).",
      "all-open-bugs": { "$value": "{ramp.indigo.10}" },
      "all-open-critical-high": { "$value": "{ramp.orange.10}" },
      "new-critical-high": { "$value": "{ramp.red.10}" },
      "new-medium-low": { "$value": "{ramp.cyan.10}" },
      "fixed-or-closed-bugs": { "$value": "{ramp.grass.10}" }
    },
    "health": {
      "$description": "Forecast health signal (sd_metrics_lib HealthStatus names, lower-cased). Dots and card stripes only; the status name is always rendered as text beside them.",
      "green": { "$value": "{ramp.grass.10}" },
      "yellow": { "$value": "{ramp.amber.9}" },
      "orange": { "$value": "{ramp.orange.10}" },
      "red": { "$value": "{ramp.red.10}" },
      "gray": { "$value": "{ramp.slate.9}" }
    }
  },
  "weight": {
    "$type": "fontWeight",
    "$description": "Optical compensation: light-on-dark text reads heavier, so the variable font steps down 20 units.",
    "regular": { "$value": "380" },
    "medium": { "$value": "480" },
    "semibold": { "$value": "580" },
    "bold": { "$value": "680" }
  },
  "shadow": {
    "$type": "shadow",
    "xs": { "$value": "0 1px 1px 0 {ramp.blackA.5}" },
    "sm": { "$value": "0 1px 2px 0 {ramp.blackA.6}, 0 1px 3px 0 {ramp.blackA.4}" },
    "md": { "$value": "0 6px 16px -4px {ramp.blackA.8}, 0 2px 4px -2px {ramp.blackA.6}" },
    "lg": { "$value": "0 20px 48px -12px {ramp.blackA.10}, 0 6px 16px -6px {ramp.blackA.8}" }
  }
}
