{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "pwsh.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
    },
    "tasks": [
        {
            "label": "Current Worktree: Local: Migrate Database",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $python = if ($env:METRICS_DASHBOARD_PYTHON) { $env:METRICS_DASHBOARD_PYTHON } else { Join-Path $workspace '.venv-embedded\\Scripts\\python.exe' }; if (-not (Test-Path -LiteralPath $python -PathType Leaf)) { throw 'Selected runtime Python is missing' }; & $python manage.py migrate; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Local: Seed Bug Trend Sample Data",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $python = if ($env:METRICS_DASHBOARD_PYTHON) { $env:METRICS_DASHBOARD_PYTHON } else { Join-Path $workspace '.venv-embedded\\Scripts\\python.exe' }; if (-not (Test-Path -LiteralPath $python -PathType Leaf)) { throw 'Selected runtime Python is missing' }; & $python manage.py seed_bug_trend_sample; exit $LASTEXITCODE",
            "dependsOn": "Current Worktree: Local: Migrate Database",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Backend: Start Django",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_start_backend.ps1'; & $script -Workspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Backend: Stop Django",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_stop_backend.ps1'; & $script -Workspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Backend: Restart Django",
            "dependsOrder": "sequence",
            "dependsOn": ["Current Worktree: Backend: Stop Django", "Current Worktree: Backend: Start Django"],
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Frontend: Open Bug Trend",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_open_bug_trend.ps1'; & $script",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Frontend: Stop Bug Trend",
            "type": "shell",
            "command": "Write-Host 'Frontend is served by Django; stop Current Worktree: Backend: Stop Django to stop the local server.'",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Frontend: Restart Bug Trend",
            "dependsOrder": "sequence",
            "dependsOn": ["Current Worktree: Frontend: Stop Bug Trend", "Current Worktree: Frontend: Open Bug Trend"],
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: E2E: Start Bug Trend",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_start_bug_trend.ps1'; & $script -Workspace $workspace -OpenEntrypoint workbench; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: E2E: Stop Bug Trend",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_stop_bug_trend.ps1'; & $script -Workspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: E2E: Restart Bug Trend",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_restart_bug_trend.ps1'; & $script -Workspace $workspace -OpenEntrypoint workbench; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Dashboard AI Stack: Start",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_dashboard_ai_stack.ps1'; & $script -Action start -DashboardWorkspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Dashboard AI Stack: Stop",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_dashboard_ai_stack.ps1'; & $script -Action stop -DashboardWorkspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "Current Worktree: Dashboard AI Stack: Restart",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_dashboard_ai_stack.ps1'; & $script -Action restart -DashboardWorkspace $workspace -SkipJiraSync; exit $LASTEXITCODE",
            "problemMatcher": []
        },
        {
            "label": "All Worktrees: Dashboard Ports Inventory",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\all_worktrees_dashboard_ports_inventory.ps1'; & $script -Workspace $workspace",
            "problemMatcher": []
        },
        {
            "label": "All Worktrees: Stop Dashboard Project Services",
            "type": "shell",
            "command": "$ErrorActionPreference = 'Stop'; $workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\all_worktrees_stop_dashboard_project_services.ps1'; & $script -Workspace $workspace; exit $LASTEXITCODE",
            "problemMatcher": []
        }
    ]
}
