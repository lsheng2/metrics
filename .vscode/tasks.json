{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
            "executable": "pwsh.exe",
            "args": ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
        }
    },
    "tasks": [
        {
            "label": "Local: Migrate Database",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $python = Join-Path $workspace '.venv\\Scripts\\python.exe'; & $python manage.py migrate",
            "problemMatcher": []
        },
        {
            "label": "Local: Seed Bug Trend Sample Data",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $python = Join-Path $workspace '.venv\\Scripts\\python.exe'; & $python manage.py seed_bug_trend_sample",
            "dependsOn": "Local: Migrate Database",
            "problemMatcher": []
        },
        {
            "label": "Backend: Start Django",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_start_backend.ps1'; & $script -Workspace $workspace",
            "problemMatcher": []
        },
        {
            "label": "Backend: Stop Django",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_stop_backend.ps1'; & $script",
            "problemMatcher": []
        },
        {
            "label": "Backend: Restart Django",
            "dependsOrder": "sequence",
            "dependsOn": ["Backend: Stop Django", "Backend: Start Django"],
            "problemMatcher": []
        },
        {
            "label": "Frontend: Open Bug Trend",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\local_open_bug_trend.ps1'; & $script",
            "problemMatcher": []
        },
        {
            "label": "Frontend: Stop Bug Trend",
            "type": "shell",
            "command": "Write-Host 'Frontend is served by Django; stop Backend: Stop Django to stop the local server.'",
            "problemMatcher": []
        },
        {
            "label": "Frontend: Restart Bug Trend",
            "dependsOrder": "sequence",
            "dependsOn": ["Frontend: Stop Bug Trend", "Frontend: Open Bug Trend"],
            "problemMatcher": []
        },
        {
            "label": "E2E: Start Bug Trend",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_start_bug_trend.ps1'; & $script -Workspace $workspace -ForceByPort",
            "problemMatcher": []
        },
        {
            "label": "E2E: Stop Bug Trend",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_stop_bug_trend.ps1'; & $script -Workspace $workspace",
            "problemMatcher": []
        },
        {
            "label": "E2E: Stop Bug Trend (Force By Port)",
            "type": "shell",
            "command": "$workspace = '${workspaceFolder}'; $script = Join-Path $workspace 'scripts\\e2e_stop_bug_trend.ps1'; & $script -Workspace $workspace -ForceByPort",
            "problemMatcher": []
        },
        {
            "label": "E2E: Restart Bug Trend",
            "dependsOrder": "sequence",
            "dependsOn": ["E2E: Stop Bug Trend", "E2E: Start Bug Trend"],
            "problemMatcher": []
        }
    ]
}