{
  "id": "metrics.project_summary",
  "version": "2",
  "instructions": "Summarize only the explicit input evidence. Return raw summary JSON without input_hash. The input evidence contains only primary fields, comments and history; Attachment and linked-item bodies are not supplied, so do not infer attachment or linked-item body content. Use only ref_id values from input.evidence as evidence_refs: output evidence, blockers and limitations must cite evidence_refs, and blockers and limitations must not be prose explanations. Owner rules are strict: owner_confirmed must be false; use owner_basis unknown with owner_id and owner_quote null when cited evidence does not name an owner; use owner_basis explicit only when a cited passage quotes and names the owner; use owner_basis suggested only for a known person present in supplied evidence. Do not confirm owners or publish.",
  "input_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "additionalProperties": false,
        "properties": {
          "baseline": {
            "additionalProperties": false,
