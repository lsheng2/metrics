{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic project reporting review fixture, not a production contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "candidate", "acceptance_context"],
  "properties": {
    "input": {"$ref": "#/$defs/input"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "acceptance_context": {"$ref": "#/$defs/context"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 16000},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "stage_id", "provider", "site", "stable_id", "rule_hash", "principal_id"],
      "properties": {
        "project_id": {"$ref": "#/$defs/text"}, "stage_id": {"$ref": "#/$defs/text"},
        "provider": {"$ref": "#/$defs/text"}, "site": {"$ref": "#/$defs/text"},
        "stable_id": {"$ref": "#/$defs/text"}, "rule_hash": {"$ref": "#/$defs/hash"},
        "principal_id": {"$ref": "#/$defs/text"}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["facts", "comments", "history"],
      "properties": {
        "facts": {"enum": ["complete", "partial", "unsupported"]},
        "comments": {"enum": ["complete", "partial", "unsupported"]},
        "history": {"enum": ["complete", "partial", "unsupported"]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["ref_id", "capture_id", "kind", "source_id", "json_pointer", "source_hash", "value"],
      "properties": {
        "ref_id": {"$ref": "#/$defs/text"}, "capture_id": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["field", "comment", "history"]},
        "source_id": {"$ref": "#/$defs/text"},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "source_hash": {"$ref": "#/$defs/hash"},
        "value": {"type": "object"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_version", "profile_revision", "binding", "target_capture_id", "baseline", "required_parts", "coverage", "delta", "evidence"],
      "properties": {
        "fixture_version": {"const": "review-1"},
        "profile_revision": {"$ref": "#/$defs/text"},
        "binding": {"$ref": "#/$defs/binding"},
        "target_capture_id": {"$ref": "#/$defs/text"},
        "baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["summary_id", "accepted_revision", "capture_id", "text"],
          "properties": {
            "summary_id": {"type": ["string", "null"]},
            "accepted_revision": {"type": "integer", "minimum": 0},
            "capture_id": {"type": ["string", "null"]}, "text": {"type": ["string", "null"]}
          }
        },
        "required_parts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["facts", "comments", "history"]}},
        "coverage": {"$ref": "#/$defs/coverage"},
        "delta": {
          "type": "object", "additionalProperties": false,
          "required": ["from_capture_id", "to_capture_id", "added_ids", "updated_ids", "deleted_ids"],
          "properties": {
            "from_capture_id": {"type": ["string", "null"]}, "to_capture_id": {"$ref": "#/$defs/text"},
            "added_ids": {"$ref": "#/$defs/ids"}, "updated_ids": {"$ref": "#/$defs/ids"},
            "deleted_ids": {"$ref": "#/$defs/ids"}
          }
        },
        "evidence": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "owner_id", "owner_basis", "owner_quote", "owner_confirmed", "state", "evidence"],
      "properties": {
        "action": {"$ref": "#/$defs/text"}, "owner_id": {"type": ["string", "null"]},
        "owner_basis": {"enum": ["explicit", "suggested", "unknown"]},
        "owner_quote": {"type": ["string", "null"], "maxLength": 16000},
        "owner_confirmed": {"const": false},
        "state": {"enum": ["open", "in_progress", "blocked", "done", "unknown"]},
        "evidence": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "binding", "profile_revision", "input_hash", "base_summary_id", "target_capture_id", "output_language", "what", "current_position", "verification", "next_actions", "blockers", "limitations", "evidence"],
      "properties": {
        "kind": {"enum": ["summary", "partial"]}, "binding": {"$ref": "#/$defs/binding"},
        "profile_revision": {"$ref": "#/$defs/text"}, "input_hash": {"$ref": "#/$defs/hash"},
        "base_summary_id": {"type": ["string", "null"]}, "target_capture_id": {"$ref": "#/$defs/text"},
        "output_language": {"const": "en"}, "what": {"$ref": "#/$defs/text"},
        "current_position": {"$ref": "#/$defs/text"}, "verification": {"$ref": "#/$defs/text"},
        "next_actions": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/action"}},
        "blockers": {"$ref": "#/$defs/ids"}, "limitations": {"$ref": "#/$defs/ids"},
        "evidence": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1}
      }
    },
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["authorized", "current_summary_id", "current_accepted_revision", "current_target_capture_id", "current_profile_revision"],
      "properties": {
        "authorized": {"type": "boolean"}, "current_summary_id": {"type": ["string", "null"]},
        "current_accepted_revision": {"type": "integer", "minimum": 0},
        "current_target_capture_id": {"$ref": "#/$defs/text"},
        "current_profile_revision": {"$ref": "#/$defs/text"}
      }
    }
  }
}
